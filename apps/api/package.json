{
  "name": "@cyberian/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "tsx scripts/prisma-command.ts generate",
    "db:migrate": "tsx scripts/prisma-command.ts migrate dev",
    "db:migrate:deploy": "tsx scripts/prisma-command.ts migrate deploy",
    "db:studio": "tsx scripts/prisma-command.ts studio",
    "data:inspect": "tsx src/data/cli/inspect-dataset.ts",
    "data:import": "tsx src/data/cli/import-dataset.ts"
  },
  "dependencies": {
    "@cyberian/shared": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@prisma/client": "6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "6.1.0",
    "joi": "^17.13.3",
    "json5": "2.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "jest": "^29.7.0",
    "prisma": "6.19.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "4.23.13",
    "typescript": "^5.7.3"
  }
}
