generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                      String   @id @default(uuid()) @db.Uuid
  sourceKey               String   @unique @map("source_key") @db.VarChar(80)
  linkedinId              String?  @map("linkedin_id") @db.VarChar(255)
  linkedinUrl             String?  @map("linkedin_url") @db.Text
  fullName                String?  @map("full_name") @db.VarChar(255)
  firstName               String?  @map("first_name") @db.VarChar(120)
  lastName                String?  @map("last_name") @db.VarChar(120)
  industry                String?  @db.VarChar(255)
  jobTitle                String?  @map("job_title") @db.VarChar(255)
  jobTitleRole            String?  @map("job_title_role") @db.VarChar(255)
  currentCompanyName      String?  @map("current_company_name") @db.VarChar(255)
  locationName            String?  @map("location_name") @db.VarChar(255)
  country                 String?  @db.VarChar(120)
  summary                 String?  @db.Text
  inferredYearsExperience Float?   @map("inferred_years_experience")
  skills                  String[] @default([])
  experience              Json?
  education               Json?
  sourceUpdatedAt         DateTime? @map("source_updated_at")
  importedAt              DateTime @default(now()) @map("imported_at")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([jobTitle])
  @@index([industry])
  @@index([country])
  @@map("profiles")
}
