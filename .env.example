# Backend
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Host development uses localhost. Compose supplies service-name URLs internally.
POSTGRES_DB=cyberian
POSTGRES_USER=cyberian
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cyberian:change-me-locally@localhost:5432/cyberian?schema=public
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_ALIAS=profiles
ELASTICSEARCH_PORT=9200
REQUEST_SIZE_LIMIT=100kb
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Frontend
VITE_API_BASE_URL=http://localhost:3000
